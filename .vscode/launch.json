{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "API Gateway-API",
            "type": "debugpy",
            "request": "launch",
            "python": "${workspaceFolder}/.venv/Scripts/python.exe",
            "module": "uvicorn",
            "cwd": "${workspaceFolder}/api-gateway-service",
            "args": [
                "app.main:app",
                "--host", "0.0.0.0",
                "--port", "8080",
                "--reload"
            ],
            "jinja": true
        },
        {
            "name": "User Service-API",
            "type": "debugpy",
            "request": "launch",
            "python": "${workspaceFolder}/.venv/Scripts/python.exe",
            "module": "uvicorn",
            "cwd": "${workspaceFolder}/user-service",
            "args": [
                "app.main:app",
                "--host", "0.0.0.0",
                "--port", "8081",
                "--reload"
            ],
            "jinja": true
        },
        {
            "name": "Blog Service-API",
            "type": "debugpy",
            "request": "launch",
            "python": "${workspaceFolder}/.venv/Scripts/python.exe",
            "module": "uvicorn",
            "cwd": "${workspaceFolder}/blog-service",
            "args": [
                "app.main:app",
                "--host", "0.0.0.0",
                "--port", "8082",
                "--reload"
            ],
            "jinja": true
        }
    ]
}